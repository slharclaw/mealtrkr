    {
      "name": "Create Recipe",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Spaghetti Carbonara\",\n  \"description\": \"Classic Italian pasta dish with pancetta and eggs\",\n  \"servings\": 4,\n  \"prep_time_minutes\": 30,\n  \"is_holiday_recipe\": false,\n  \"ingredients\": [\n    {\n      \"name\": \"Spaghetti\",\n      \"amount\": \"400g\"\n    },\n    {\n      \"name\": \"Pancetta\",\n      \"amount\": \"200g\"\n    },\n    {\n      \"name\": \"Eggs\",\n      \"amount\": \"4 large\"\n    },\n    {\n      \"name\": \"Parmesan cheese\",\n      \"amount\": \"100g grated\"\n    }\n  ],\n  \"directions\": [\n    {\n      \"step_text\": \"Boil water and cook spaghetti according to package directions\",\n      \"step_number\": 1\n    },\n    {\n      \"step_text\": \"Fry pancetta until crispy in a large pan\",\n      \"step_number\": 2\n    },\n    {\n      \"step_text\": \"Beat eggs in a bowl with grated parmesan\",\n      \"step_number\": 3\n    },\n    {\n      \"step_text\": \"Drain pasta, reserving 1 cup pasta water\",\n      \"step_number\": 4\n    },\n    {\n      \"step_text\": \"Combine hot pasta with pancetta, remove from heat\",\n      \"step_number\": 5\n    },\n    {\n      \"step_text\": \"Stir in egg mixture, adding pasta water as needed for sauce\",\n      \"step_number\": 6\n    },\n    {\n      \"step_text\": \"Serve immediately with extra parmesan\",\n      \"step_number\": 7\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/recipes",
          "host": ["{{base_url}}"],
          "path": ["recipes"]
        }
      }
    },
    {
      "name": "Update Recipe",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Spaghetti Carbonara (Updated)\",\n  \"description\": \"Classic Italian pasta dish\",\n  \"servings\": 6,\n  \"prep_time_minutes\": 25,\n  \"ingredients\": [\n    {\n      \"name\": \"Spaghetti\",\n      \"amount\": \"600g\"\n    },\n    {\n      \"name\": \"Pancetta\",\n      \"amount\": \"300g\"\n    },\n    {\n      \"name\": \"Eggs\",\n      \"amount\": \"6 large\"\n    },\n    {\n      \"name\": \"Parmesan cheese\",\n      \"amount\": \"150g grated\"\n    }\n  ],\n  \"directions\": [\n    {\n      \"step_text\": \"Boil water and cook spaghetti according to package directions\",\n      \"step_number\": 1\n    },\n    {\n      \"step_text\": \"Fry pancetta until crispy\",\n      \"step_number\": 2\n    },\n    {\n      \"step_text\": \"Beat eggs with grated parmesan\",\n      \"step_number\": 3\n    },\n    {\n      \"step_text\": \"Combine hot pasta with pancetta, then stir in egg mixture\",\n      \"step_number\": 4\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/recipes/1",
          "host": ["{{base_url}}"],
          "path": ["recipes", "1"]
        }
      }
