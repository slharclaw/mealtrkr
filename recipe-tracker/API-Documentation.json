        "body": {
          "mode": "raw",
          "raw": "{\n  \"json_data\": {\n    \"title\": \"Quick Chicken Stir Fry\",\n    \"description\": \"Fast weeknight dinner\",\n    \"servings\": 2,\n    \"prep_time_minutes\": 20,\n    \"is_holiday_recipe\": false,\n    \"ingredients\": [\n      {\"name\": \"Chicken breast\", \"amount\": \"2 pieces\"},\n      {\"name\": \"Mixed vegetables\", \"amount\": \"2 cups\"},\n      {\"name\": \"Soy sauce\", \"amount\": \"3 tbsp\"},\n      {\"name\": \"Garlic, minced\", \"amount\": \"2 cloves\"}\n    ],\n    \"directions\": [\n      {\"step_text\": \"Slice chicken into strips\", \"step_number\": 1},\n      {\"step_text\": \"Stir fry chicken until cooked through\", \"step_number\": 2},\n      {\"step_text\": \"Add vegetables and garlic\", \"step_number\": 3},\n      {\"step_text\": \"Add soy sauce and serve over rice\", \"step_number\": 4}\n    ]\n  }\n}"
        },
        "url": {
